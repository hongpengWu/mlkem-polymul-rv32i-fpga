/build/
/.Xil/
/hls/.Xil/
/hls/mlkem512_basemul_k2/build/
/hls/mlkem512_basemul_k2/mlkem512_basemul_k2_vivado/

# CPU-only and ML-KEM software Vivado projects keep only XPR/MEM (and tracked XCI if added).
/vivado/cpu_baseline_rv32i/*
!/vivado/cpu_baseline_rv32i/cpu_baseline.xpr
!/vivado/cpu_baseline_rv32i/cpu_baseline.mem
/vivado/cpu_baseline_rv32im_iterative/*
!/vivado/cpu_baseline_rv32im_iterative/cpu_baseline.xpr
!/vivado/cpu_baseline_rv32im_iterative/cpu_baseline.mem
/vivado/cpu_baseline_rv32im_fast/*
!/vivado/cpu_baseline_rv32im_fast/cpu_baseline.xpr
!/vivado/cpu_baseline_rv32im_fast/cpu_baseline.mem
/vivado/mlkem_keygen_*/*
!/vivado/mlkem_keygen_*/*.xpr
!/vivado/mlkem_keygen_*/mlkem_keygen.mem
/vivado/mlkem512_*/*
!/vivado/mlkem512_*/mlkem512.xpr
!/vivado/mlkem512_*/mlkem512.mem

*.jou
*.log
!/results/cpu_baseline/rv32i/simulate.log
!/results/cpu_baseline/rv32im_iterative/simulate.log
!/results/cpu_baseline/rv32im_fast/simulate.log
!/results/official_reference/*.log
!/results/official_baseline/keygen512_tc1/*/simulate.log
!/results/official_baseline/mlkem512/*/simulate.log
!/results/official_baseline/mlkem512/batches/**/simulate.log
!/results/official_baseline/mlkem512/profile/batches/**/simulate.log
!/results/accelerator_interface/hls_synthesis/*.log

*.backup.*
*.str
*.wdb
*.wcfg
*.dcp
*.bit
!/release/cpu_baseline_rv32i/*.bit
!/release/cpu_baseline_rv32im_iterative/*.bit
!/release/cpu_baseline_rv32im_fast/*.bit
*.bin
!/release/mlkem512_basemul_k2/*.bit
!/results/accelerator_interface/rtl_sim/*.log
!/vivado/mlkem512_basemul_k2/basemul.xpr
*.elf
__pycache__/
Thumbs.db
dfx_runtime.txt
.hls.failed
.hls.success
